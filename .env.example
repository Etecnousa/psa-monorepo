# ============================================================================
# PSAO - Variables de Entorno (Ejemplo)
# ============================================================================

# Database
POSTGRES_USER=psa_dev
POSTGRES_PASSWORD=psa_dev_password
POSTGRES_DB=psa_dev_db

# Redis
REDIS_PASSWORD=redis_dev_password

# MinIO
MINIO_ROOT_USER=minio_dev
MINIO_ROOT_PASSWORD=minio_dev_password

# JWT
JWT_SECRET=change_this_to_a_secure_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_this_to_another_secure_random_string

# SMTP (para notificaciones por email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_password

# Domains (para producción con Traefik)
API_DOMAIN=api.psa.local
WEB_DOMAIN=psa.local
ACME_EMAIL=admin@psa.local
